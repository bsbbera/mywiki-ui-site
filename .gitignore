# Quartz
node_modules/
public/
.quartz-cache/
*.log
.DS_Store
tsconfig.tsbuildinfo

# Claude Code local state (worktrees, launch config) — never deploy
.claude/

# Obsidian (keep config but skip workspace state & plugin data that may hold tokens)
**/.obsidian/workspace*
**/.obsidian/cache
**/.obsidian/.trash/
**/.obsidian/plugins/**/data.json
**/.obsidian/plugins/obsidian-excalidraw-plugin/
**/.obsidian/plugins/obsidian-git/data.json

# Content is auto-copied from MyWiki vault at build time
# NOTE: We DO commit content/ to git so Vercel has access to it.
# Run `npm run prebuild` locally before committing to sync vault changes.

# graphify output is NEVER deployed (knowledge-graph tooling artifacts).
# Belt-and-braces: even if something lands in content/, never commit it.
# See docs/DEPLOY-RULES.md and scripts/copy-vault-content.js.
graphify-out/
**/graphify-out/
**/GRAPH_REPORT.md
content/**/graphify*/
content/**/GRAPH_REPORT.md

# Vercel
.vercel
.env
.env.local
