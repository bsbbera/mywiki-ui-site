# Quartz
node_modules/
public/
.quartz-cache/
*.log
.DS_Store

# Obsidian (keep config but skip workspace state & plugin data that may hold tokens)
**/.obsidian/workspace*
**/.obsidian/cache
**/.obsidian/.trash/
**/.obsidian/plugins/**/data.json
**/.obsidian/plugins/obsidian-excalidraw-plugin/
**/.obsidian/plugins/obsidian-git/data.json

# Content is auto-copied from MyWiki vault at build time
# NOTE: We DO commit content/ to git so Vercel has access to it.
# Run `npm run prebuild` locally before committing to sync vault changes.

# Vercel
.vercel
.env
.env.local
